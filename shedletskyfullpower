local function zeroVelocity(hrp)
	pcall(function()
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
	end)
end

local function flipCF(cf)
	if CONFIG.FLIP_MODEL then
		return cf * CFrame.Angles(0, math.pi, 0)
	end
	return cf
end

local function easeOutQuad(t) return 1 - (1 - t) * (1 - t) end

local function hasDesync()
	return type(NAmanage) == "table"
		and type(NAStuff) == "table"
		and type(NAmanage.SetOffsetDesync) == "function"
end

local function setDesyncAnchor(cf)
	if typeof(cf) ~= "CFrame" or type(NAStuff) ~= "table" then return false end
	local ok, observed = pcall(function()
		NAStuff.desyncOffsetAnchor = cf
		return NAStuff.desyncOffsetAnchor
	end)
	return ok and typeof(observed) == "CFrame"
end

local function killerPrimaryPart(killerModel)
	if not killerModel then return nil end
	if killerModel.PrimaryPart then return killerModel.PrimaryPart end
	return killerModel:FindFirstChild("HumanoidRootPart")
end

local function isValidKiller(model)
	if not model or not model.Parent or not model:IsA("Model") then return false end
	local hum = model:FindFirstChildOfClass("Humanoid")
	return hum ~= nil and hum.Health > 0 and killerPrimaryPart(model) ~= nil
end

local function computeHitCFrame(killerPrimary, attackerPos, lunge, lead)
	local pos = killerPrimary.Position
	if lead then pos = pos + lead end
	local origin = attackerPos or (pos + Vector3.new(0, 0, 1))
	local dir = Vector3.new(pos.X - origin.X, 0, pos.Z - origin.Z)
	if dir.Magnitude < 0.01 then dir = Vector3.new(0, 0, -1) end
	dir = dir.Unit
	local cf = CFrame.lookAt(pos, pos + dir)
	cf = flipCF(cf)
	if lunge and lunge > 0 then
		cf = cf * CFrame.new(0, 0, lunge)
	end
	return cf
end

local velEMA = Vector3.zero
local velState = { lastPos = nil, lastTime = nil, target = nil }
local function flattenXZ(v) return Vector3.new(v.X, 0, v.Z) end

local function predictLead(kp, killerHRP, now)
	if not kp or not kp.Parent then return Vector3.zero end
	local vel = Vector3.zero
	local pos = kp.Position
	if velState.target ~= kp then
		velState.lastPos, velState.lastTime, velState.target = nil, nil, kp
		velEMA = Vector3.zero
	end

	if killerHRP and killerHRP:IsA("BasePart") then
		local v = flattenXZ(killerHRP.AssemblyLinearVelocity)
		if v.Magnitude > 0.05 and v.Magnitude < 100 then
			vel = v
		end
	end

	if vel.Magnitude < 0.05 and velState.lastPos and velState.lastTime then
		local d = now - velState.lastTime
		if d > 0.02 then
			local v = flattenXZ((pos - velState.lastPos) / d)
			if v.Magnitude < 100 then vel = v end
		end
	end
	velState.lastPos = pos
	velState.lastTime = now

	velEMA = velEMA:Lerp(vel, 0.5)
	local spd = velEMA.Magnitude
	local lead = Vector3.zero
	if spd >= 0.01 then
		lead = (velEMA / spd) * math.min(spd * math.max(0, CONFIG.LEAD_TIME), math.max(0, CONFIG.LEAD_MAX))
	end
	local airborne = false
	if CONFIG.PREDICT_AIRBORNE_Y and killerHRP and killerHRP:IsA("BasePart") then
		local model = killerHRP:FindFirstAncestorOfClass("Model")
		local hum = model and model:FindFirstChildOfClass("Humanoid")
		if hum then
			local state = hum:GetState()
			airborne = state == Enum.HumanoidStateType.Jumping
				or state == Enum.HumanoidStateType.Freefall
				or state == Enum.HumanoidStateType.FallingDown
		end
	end
	if airborne and killerHRP and killerHRP:IsA("BasePart") then
		local y = killerHRP.AssemblyLinearVelocity.Y * math.max(0, CONFIG.LEAD_TIME)
		lead = Vector3.new(lead.X, math.clamp(y, -CONFIG.LEAD_MAX, CONFIG.LEAD_MAX), lead.Z)
	end
	return lead
end

local charFrozen = false
local prevHumState = Enum.HumanoidStateType.Running

local function freezeCharacter(hrp, humanoid)
	if charFrozen then return true end
	local ok = pcall(function()
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
		hrp.Anchored = true
		if CONFIG.FREEZE_HUMANOID and humanoid and humanoid.Parent and humanoid.Health > 0 then
			prevHumState = humanoid:GetState()
			humanoid:ChangeState(Enum.HumanoidStateType.Physics)
		end
		charFrozen = true
	end)
	return ok
end

local function unfreezeCharacter(hrp, humanoid)
	if not charFrozen then return end
	charFrozen = false
	pcall(function()
		hrp.Anchored = false
		zeroVelocity(hrp)
		if CONFIG.FREEZE_HUMANOID and humanoid and humanoid.Parent and humanoid.Health > 0 then
			pcall(function() humanoid:ChangeState(prevHumState) end)
		end
	end)
end

local function antiLerpTeleport(char, hrp, humanoid, targetCF, opts)
	local holdS = CONFIG.ANCHOR_HOLD_S
	local reassertS = CONFIG.REASSERT_S
	if type(opts) == "table" then
		if opts.hold ~= nil then holdS = opts.hold end
		if opts.reassert ~= nil then reassertS = opts.reassert end
	end

	local frozen = false
	local prevState = Enum.HumanoidStateType.Running

	local function restoreMotion()
		if frozen then
			frozen = false
			pcall(function()
				if humanoid and humanoid.Parent and humanoid.Health > 0 then
					humanoid:ChangeState(prevState)
				end
			end)
		end
		pcall(function()
			hrp.Anchored = false
			zeroVelocity(hrp)
		end)
	end

	local ok = pcall(function()
		hrp:SetNetworkOwner(lp)
		zeroVelocity(hrp)
		if CONFIG.FREEZE_HUMANOID and humanoid and humanoid.Parent and humanoid.Health > 0 then
			prevState = humanoid:GetState()
			humanoid:ChangeState(Enum.HumanoidStateType.Physics)
			frozen = true
		end
		hrp.Anchored = true
		char:PivotTo(targetCF)
		zeroVelocity(hrp)
	end)
	if not ok then
		restoreMotion()
		return
	end

	local holdStart = time()
	local holdFrames = 0
	while time() - holdStart < holdS do
		RunService.PostSimulation:Wait()
		holdFrames += 1
		if holdFrames % 3 == 0 then
			pcall(function()
				char:PivotTo(targetCF)
				zeroVelocity(hrp)
			end)
		end
	end

	pcall(function()
		hrp.Anchored = false
		char:PivotTo(targetCF)
		zeroVelocity(hrp)
	end)
	restoreMotion()

	local reassertStart = time()
	while time() - reassertStart < reassertS do
		RunService.PostSimulation:Wait()
		pcall(function()
			char:PivotTo(targetCF)
			zeroVelocity(hrp)
		end)
	end
end

local function findKillerModel(origin, facing)
	local pf = workspace:FindFirstChild("Players")
	local kf = pf and pf:FindFirstChild("Killers")
	if not kf then return nil end
	local best, bestDist = nil, math.huge
	local cosHalfCone = math.cos(math.rad(math.clamp(CONFIG.TARGET_CONE_DEG, 0, 360) * 0.5))
	-- Killers are direct children of this folder. Scanning every descendant also
	-- visits every limb/accessory and becomes noticeably expensive on attack.
	for _, v in ipairs(kf:GetChildren()) do
		if isValidKiller(v) then
			local kp = killerPrimaryPart(v)
			local delta = kp.Position - origin
			local dist = delta.Magnitude
			local inCone = true
			if facing and dist > 0.01 and CONFIG.TARGET_CONE_DEG < 360 then
				inCone = facing:Dot(delta.Unit) >= cosHalfCone
			end
			if inCone and dist < bestDist then
				best, bestDist = v, dist
			end
		end
	end
	return best
end

local function runPrimaryPart(char, hrp, humanoid, km, tp, kHRP, fromPos, HOLD, serial)
	if CONFIG.SILENT_AIM and kHRP then
		pcall(function()
			local look = Vector3.new(kHRP.Position.X - fromPos.X, 0, kHRP.Position.Z - fromPos.Z)
			if look.Magnitude > 0.01 then
				local aimCF
				if CONFIG.FLIP_MODEL then
					aimCF = CFrame.lookAt(hrp.Position, hrp.Position - look.Unit)
				else
					aimCF = CFrame.lookAt(hrp.Position, hrp.Position + look.Unit)
				end
				antiLerpTeleport(char, hrp, humanoid, aimCF)
			end
		end)
	end

	velState.lastPos, velState.lastTime, velState.target = nil, nil, nil
	velEMA = Vector3.zero

	local targetCF0 = computeHitCFrame(tp, fromPos, 0)

	local part = Instance.new("Part")
	part.Name = "TempPrimaryPart"
	part.Size = Vector3.new(CONFIG.PARK_PART_SIZE, CONFIG.PARK_PART_SIZE, CONFIG.PARK_PART_SIZE)
	part.Transparency = 1
	part.CanCollide = false
	part.CastShadow = false
	part.Massless = true
	part.Anchored = true
	part.CFrame = targetCF0
	part.Parent = char

	local oldPrimary = char.PrimaryPart
	local swapped = pcall(function() char.PrimaryPart = part end)
	if not swapped or char.PrimaryPart ~= part then
		pcall(function() part:Destroy() end)
		running = false
		return
	end

	if CONFIG.FREEZE_HOLD then
		pcall(function()
			hrp:SetNetworkOwner(lp)
			hrp.Anchored = true
			zeroVelocity(hrp)
		end)
	end

	local timer = 0
	local lastParkCF = targetCF0
	local impacted = false
	local conn

	local function updateParkCFrame()
		if not isValidKiller(km) then return end
		local kp = killerPrimaryPart(km)
		if not kp then return end
		local khrp2 = km:FindFirstChild("HumanoidRootPart")
		local lead = predictLead(kp, khrp2, time())

		local lunge = 0
		if CONFIG.LUNGE_STUDS > 0 and timer >= CONFIG.WINDUP then
			if CONFIG.LINGER_SMEAR then
				local lapse = timer - CONFIG.WINDUP
				local steps = math.max(1, math.floor(CONFIG.LUNGE_STUDS / CONFIG.LINGER_SMEAR_STUDS + 0.5))
				local stepDur = math.max(CONFIG.LINGER / steps, 0.001)
				local stepNum = math.min(steps, math.floor(lapse / stepDur) + 1)
				lunge = (CONFIG.LUNGE_STUDS / steps) * stepNum
			else
				lunge = CONFIG.LUNGE_STUDS
			end
		end

		local cf = computeHitCFrame(kp, hrp.Position, lunge, lead)

		if not impacted and timer >= CONFIG.WINDUP then
			impacted = true
			lastParkCF = cf
			part.CFrame = cf
			return
		end

		if (cf.Position - lastParkCF.Position).Magnitude < CONFIG.PARK_SNAP_THRESHOLD then
			return
		end
		lastParkCF = cf
		part.CFrame = cf
	end

	local function cleanup()
		if not running or serial ~= attackSerial then return end
		running = false
		if activeCleanup == cleanup then activeCleanup = nil end
		if conn then conn:Disconnect(); conn = nil end
		pcall(function()
			char.PrimaryPart = (oldPrimary and oldPrimary.Parent == char) and oldPrimary or hrp
		end)
		pcall(function() part:Destroy() end)
		if CONFIG.FREEZE_HOLD then
			pcall(function()
				hrp.Anchored = false
				zeroVelocity(hrp)
			end)
		end

		if humanoid and humanoid.Parent and humanoid.Health > 0 then
			pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.Running) end)
		end
	end
	activeCleanup = cleanup

	conn = RunService.PreSimulation:Connect(function(dt)
		local ok = pcall(function()
			if not char.Parent or not part.Parent or not CONFIG.isEnabled
				or (humanoid and humanoid.Parent and humanoid.Health <= 0) then
				cleanup()
				return
			end
			timer += dt
			if timer >= HOLD then
				cleanup()
				return
			end
			updateParkCFrame()
		end)
		if not ok then cleanup() end
	end)

	task.delay(HOLD + 1, function()
		if running and serial == attackSerial then cleanup() end
	end)
end

local function runDesync(char, hrp, humanoid, km, tp, kHRP, fromPos, dist, HOLD, serial)
	local function fallbackToPrimary()
		pcall(function() NAmanage.SetOffsetDesync(false) end)
		unfreezeCharacter(hrp, humanoid)
		activeCleanup = nil
		local ok = pcall(runPrimaryPart, char, hrp, humanoid, km, tp, kHRP, fromPos, HOLD, serial)
		if not ok then
			if activeCleanup then pcall(activeCleanup) else running = false end
		end
	end

	local okEnable = pcall(function() NAmanage.SetOffsetDesync(true) end)
	if not okEnable then
		fallbackToPrimary()
		return
	end

	local function emergencyCleanup()
		if serial ~= attackSerial then return end
		pcall(function() NAmanage.SetOffsetDesync(false) end)
		unfreezeCharacter(hrp, humanoid)
		running = false
		if activeCleanup == emergencyCleanup then activeCleanup = nil end
	end
	activeCleanup = emergencyCleanup

	if CONFIG.DESYNC_FREEZE then
		if not freezeCharacter(hrp, humanoid) then
			fallbackToPrimary()
			return
		end
	end

	velState.lastPos, velState.lastTime, velState.target = nil, nil, nil
	velEMA = Vector3.zero

	local firstCF = computeHitCFrame(tp, fromPos, 0)

	local useOvershoot = CONFIG.OVERSHOOT_SNAP
		and (dist >= CONFIG.OVERSHOOT_MIN_DIST or CONFIG.OVERSHOOT_ALL)

	if useOvershoot then
		local overshootOK = pcall(function()
			local dirRK = firstCF.Position - fromPos
			if dirRK.Magnitude < 0.01 then dirRK = Vector3.new(0, 0, -1) end
			dirRK = dirRK.Unit
			local waypoint = firstCF.Position + dirRK * (CONFIG.SNAP_FLOOR_STUDS + CONFIG.OVERSHOOT_PAD_STUDS)
			assert(setDesyncAnchor(firstCF + (waypoint - firstCF.Position)), "desync waypoint write failed")
		end)
		if not overshootOK then
			fallbackToPrimary()
			return
		end
		RunService.PostSimulation:Wait()
	end

	if not setDesyncAnchor(firstCF) then
		fallbackToPrimary()
		return
	end

	local timer = 0
	local conn

	local function finish()
		if not running or serial ~= attackSerial then return end
		running = false
		if activeCleanup == finish then activeCleanup = nil end
		if conn then conn:Disconnect(); conn = nil end

		if char and char.Parent and hrp and hrp.Parent then
			local startAnchor = NAStuff and NAStuff.desyncOffsetAnchor
			if typeof(startAnchor) ~= "CFrame" then startAnchor = hrp.CFrame end
			local convStart = time()
			while time() - convStart < CONFIG.DESYNC_CONVERGE_S do
				RunService.PostSimulation:Wait()
				if not char.Parent or not hrp.Parent then break end
				local alpha = math.min(1, (time() - convStart) / CONFIG.DESYNC_CONVERGE_S)
				local tgt = startAnchor:Lerp(hrp.CFrame, easeOutQuad(alpha))
				setDesyncAnchor(tgt)
			end
			setDesyncAnchor(hrp.CFrame)
			RunService.PostSimulation:Wait()
		end

		pcall(function() NAmanage.SetOffsetDesync(false) end)
		unfreezeCharacter(hrp, humanoid)
		zeroVelocity(hrp)
		if humanoid and humanoid.Parent and humanoid.Health > 0 then
			pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.Running) end)
		end
	end
	activeCleanup = finish

	conn = RunService.PreSimulation:Connect(function(dt)
		local ok = pcall(function()
			if not char.Parent then
				finish()
				return
			end
			if not CONFIG.isEnabled then
				finish()
				return
			end
			timer += dt
			if timer >= HOLD then
				finish()
				return
			end

			if not isValidKiller(km) then return end
			local kp2 = killerPrimaryPart(km)
			if not kp2 then return end
			local khrp2 = km:FindFirstChild("HumanoidRootPart")
			local lead = predictLead(kp2, khrp2, time())
			local cf = computeHitCFrame(kp2, hrp.Position, 0, lead)

			if not setDesyncAnchor(cf) then finish() end
		end)
		if not ok then finish() end
	end)

	task.delay(HOLD + CONFIG.DESYNC_CONVERGE_S + 1, function()
		if running and serial == attackSerial then finish() end
	end)
end

