local function cleanObj(obj)
	if obj:IsA("BasePart") then
		if obj.Material ~= Enum.Material.SmoothPlastic then obj.Material = Enum.Material.SmoothPlastic end
		if obj.CastShadow then obj.CastShadow = false end
		if obj.Reflectance ~= 0 then obj.Reflectance = 0 end
	elseif obj:IsA("Decal") or obj:IsA("Texture") then
		obj:Destroy()
	elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
		if obj.Enabled then obj.Enabled = false end
	end
end

-- Process world cleanup in bounded batches so loading a map does not freeze a
-- frame or create one scheduler task per descendant.
local cleanQueue = Workspace:GetDescendants()
local cleanHead = 1
local cleanTail = #cleanQueue
local CLEAN_BATCH_SIZE = 100

local function enqueueClean(obj)
	cleanTail += 1
	cleanQueue[cleanTail] = obj
end

Workspace.DescendantAdded:Connect(function(obj)
	enqueueClean(obj)
end)

RunService.Heartbeat:Connect(function()
	local batchEnd = math.min(cleanTail, cleanHead + CLEAN_BATCH_SIZE - 1)
	while cleanHead <= batchEnd do
		local obj = cleanQueue[cleanHead]
		cleanQueue[cleanHead] = nil
		cleanHead += 1
		if obj and obj.Parent then pcall(cleanObj, obj) end
	end
	if cleanHead > cleanTail then
		cleanQueue = {}
		cleanHead = 1
		cleanTail = 0
	end
end)


-- auto gen 1.5s

local isFixing = false
local fixThread = nil

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()

    if not checkcaller() and method == "InvokeServer" and self.Name == "RF" then
		local action = select(1, ...)
		if action == "Enter" then
            isFixing = true
            if fixThread then
                task.cancel(fixThread)
            end
            fixThread = task.spawn(function()
                while isFixing do
                    task.wait(1.5)
                    if not isFixing then break end
                    local remotes = self.Parent
                    if remotes and remotes:FindFirstChild("RE") then
                        remotes.RE:FireServer()
                    end
                end
            end)
		elseif action == "Leave" then
            isFixing = false
            if fixThread then
                task.cancel(fixThread)
                fixThread = nil
            end
        end
    end

    return oldNamecall(self, ...)
end)
