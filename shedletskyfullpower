local espRecords = {}

local function applyESP(mod, killer)
	if mod:FindFirstChild("ESP_Highlight") then return end

	local root = mod:WaitForChild("HumanoidRootPart", 5)
	local hum = mod:WaitForChild("Humanoid", 5)
	if not root or not hum then return end

	local hl = Instance.new("Highlight")
	hl.Name = "ESP_Highlight"
	hl.Adornee = mod
	hl.FillColor = killer and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(50, 255, 50)
	hl.FillTransparency = 0.5
	hl.OutlineColor = Color3.fromRGB(255, 255, 255)
	hl.OutlineTransparency = 0
	hl.Enabled = CONFIG.ESP_ENABLED
	hl.Parent = mod

	local bb = Instance.new("BillboardGui")
	bb.Name = "ESP_Billboard"
	bb.Size = UDim2.new(0, 200, 0, 50)
	bb.AlwaysOnTop = true
	bb.Enabled = CONFIG.ESP_ENABLED
	bb.Parent = mod

	local txt = Instance.new("TextLabel")
	txt.Size = UDim2.new(1, 0, 1, 0)
	txt.BackgroundTransparency = 1
	txt.TextColor3 = killer and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(80, 255, 80)
	txt.Font = Enum.Font.GothamBold
	txt.TextSize = 13
	txt.TextStrokeTransparency = 0
	txt.Parent = bb

	bb.Parent = root
	bb.StudsOffset = Vector3.new(0, (root.Size.Y / 2) + 1.75, 0)
	espRecords[mod] = {
		root = root, hum = hum, label = txt, killer = killer,
		highlight = hl, billboard = bb, visible = CONFIG.ESP_ENABLED,
	}
end

local ESP_UPDATE_INTERVAL = 0.1
local espElapsed = ESP_UPDATE_INTERVAL
RunService.Heartbeat:Connect(function(dt)
	espElapsed += dt
	if espElapsed < ESP_UPDATE_INTERVAL then return end
	espElapsed = 0

	local cam = workspace.CurrentCamera
	local camPos = cam and cam.CFrame.Position
	for mod, record in pairs(espRecords) do
		if not mod.Parent or not record.root.Parent or not record.hum.Parent then
			espRecords[mod] = nil
		else
			if record.visible ~= CONFIG.ESP_ENABLED then
				record.visible = CONFIG.ESP_ENABLED
				record.highlight.Enabled = CONFIG.ESP_ENABLED
				record.billboard.Enabled = CONFIG.ESP_ENABLED
			end
			if not CONFIG.ESP_ENABLED then continue end
			local dist = camPos and math.floor((camPos - record.root.Position).Magnitude) or 0
			local text
			if record.killer then
				text = string.format("Killer | %dm", dist)
			else
				local hp = math.max(0, math.floor(record.hum.Health))
				text = string.format("Survivor | HP: %d | %dm", hp, dist)
			end
			if record.lastText ~= text then
				record.lastText = text
				record.label.Text = text
			end
		end
	end
end)

