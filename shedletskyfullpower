local function triggerTeleport()
	if not CONFIG.isEnabled or running then return end
	running = true

	local char = lp.Character or lp.CharacterAdded:Wait()
	local hrp = char:WaitForChild("HumanoidRootPart", 5)
	local humanoid = char:WaitForChild("Humanoid", 5)
	if not hrp or not humanoid or not char.Parent then
		running = false
		return
	end

	local fromPos = hrp.CFrame.Position
	local facing = hrp.CFrame.LookVector
	local km = findKillerModel(fromPos, facing)
	local tp = killerPrimaryPart(km)
	if not tp or not char.Parent then
		running = false
		return
	end

	local HOLD = CONFIG.WINDUP + CONFIG.LINGER

	local dist = (tp.Position - fromPos).Magnitude
	if dist < CONFIG.frontstuds then
		running = false
		return
	end
	if CONFIG.MAX_ATTACK_RANGE > 0 and dist > CONFIG.MAX_ATTACK_RANGE then
		running = false
		return
	end

	local kHRP = km and km:FindFirstChild("HumanoidRootPart")

	attackSerial += 1
	local serial = attackSerial
	activeCleanup = nil
	task.spawn(function()
		local delayS = math.max(0, CONFIG.startdelay)
		if delayS > 0 then task.wait(delayS) end
		if not running or serial ~= attackSerial or not CONFIG.isEnabled or not char.Parent then
			running = false
			return
		end
		if not isValidKiller(km) then
			running = false
			return
		end
		tp = killerPrimaryPart(km)
		kHRP = km:FindFirstChild("HumanoidRootPart")
		fromPos = hrp.Position
		dist = (tp.Position - fromPos).Magnitude
		if dist < CONFIG.frontstuds
			or (CONFIG.MAX_ATTACK_RANGE > 0 and dist > CONFIG.MAX_ATTACK_RANGE) then
			running = false
			return
		end
		local ok
		if CONFIG.method == "Desync" and hasDesync() then
			ok = pcall(runDesync, char, hrp, humanoid, km, tp, kHRP, fromPos, dist, HOLD, serial)
		else
			ok = pcall(runPrimaryPart, char, hrp, humanoid, km, tp, kHRP, fromPos, HOLD, serial)
		end
		if not ok then
			if activeCleanup then
				pcall(activeCleanup)
			else
				running = false
			end
		end
	end)
end

