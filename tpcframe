-- main sequence logic
local function findKillerModel()
	local pf = workspace:FindFirstChild("Players")
	if not pf then return end
	local kf = pf:FindFirstChild("Killers")
	if not kf then return end
	
	for _, child in ipairs(kf:GetDescendants()) do
		if child:IsA("Model") then
			local h = child:FindFirstChildOfClass("Humanoid")
			local r = child:FindFirstChild("HumanoidRootPart")
			if h and r and h.Health > 0 then
				return child
			end
		end
	end
	return nil
end

local function triggerTeleport()
	if not isEnabled or running then return end
	running = true

	local char = lp.Character or lp.CharacterAdded:Wait()
	local hrp = char:WaitForChild("HumanoidRootPart")

	task.wait(startdelay)
	if not char.Parent then
		running = false
		return
	end

	local part = Instance.new("Part")
	part.Name = "place"
	part.Size = Vector3.new(2, 2, 2)
	part.Transparency = 0
	part.CanCollide = false
	part.Anchored = true
	part.Parent = char

	local oldPrimary = char.PrimaryPart
	char.PrimaryPart = part

	local timer = 0
	local stepConn
	stepConn = RunService.Heartbeat:Connect(function(dt)
		if not char.Parent or not part.Parent or not isEnabled then
			stepConn:Disconnect()
			if part.Parent then part:Destroy() end
			if char.Parent then char.PrimaryPart = oldPrimary end
			running = false
			return
		end
		
		timer += dt
		if timer >= duration then
			stepConn:Disconnect()
			if part.Parent then part:Destroy() end
			if char.Parent then char.PrimaryPart = oldPrimary end
			running = false
			return
		end

		local kModel = findKillerModel()
		if kModel then
			local kHrp = kModel:FindFirstChild("HumanoidRootPart")
			if kHrp then
				local vel = kHrp.AssemblyLinearVelocity
				local flatVel = Vector3.new(vel.X, 0, vel.Z)

				local offset = Vector3.new(0, 0, 0)
				if flatVel.Magnitude > 0.5 then
					offset = flatVel * dt * getPredictMult()
				end

				local targetPos = kHrp.Position + offset
				local targetCFrame = CFrame.new(targetPos) * (kHrp.CFrame - kHrp.CFrame.Position)

				part.CFrame = targetCFrame 
					* CFrame.new(0, 0, FRONT_SIGN * frontstuds) 
					* CFrame.Angles(0, math.pi, 0)

				hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
			end
		end
	end)
end

local function onCharAdded(char)
	local hum = char:WaitForChild("Humanoid")
	local animator = hum:WaitForChild("Animator")
	
	animator.AnimationPlayed:Connect(function(track)
		if not track or not track.Animation then return end
		local animId = tostring(track.Animation.AnimationId or ""):gsub("%D", "")
		if animId == TARGET_ANIM and isEnabled then
			task.spawn(triggerTeleport)
		end
	end)
end

if lp.Character then
	onCharAdded(lp.Character)
end
lp.CharacterAdded:Connect(onCharAdded)

-- inf stamina
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

local function applyStaminaHack()
    local systems = ReplicatedStorage:FindFirstChild("Systems")
    local sprintingModule = systems 
        and systems:FindFirstChild("Character") 
        and systems.Character:FindFirstChild("Game") 
        and systems.Character.Game:FindFirstChild("Sprinting")

    if not sprintingModule then return end

    local success, Sprint = pcall(require, sprintingModule)
    if not success or type(Sprint) ~= "table" then return end

    if rawget(Sprint, "StaminaLoss") then
        Sprint.StaminaLoss = 0
    end

    local event = rawget(Sprint, "__staminaChangedEvent")
    if event and type(event.Fire) == "function" and not rawget(event, "_hooked") then
        rawset(event, "_hooked", true)
        local oldFire = event.Fire
        event.Fire = function(self, val, ...)
            return oldFire(self, rawget(Sprint, "MaxStamina") or val, ...)
        end
    end

    if rawget(Sprint, "MaxStamina") then
        Sprint.Stamina = Sprint.MaxStamina
        if event and type(event.Fire) == "function" then
            event:Fire(Sprint.MaxStamina)
        end
    end
end

task.spawn(function()
    while true do
        pcall(applyStaminaHack)
        task.wait(0.5)
    end
end)

pcall(function()
    StarterGui:SetCore("SendNotification", {
        Title = "Inf stamina",
        Text = "loaded successfully!",
        Duration = 3
    })
end)

