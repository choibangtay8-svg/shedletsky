local function makeSetting(lblText, defaultVal, onChange)
	local boxFrame = Instance.new("Frame")
	boxFrame.Size = UDim2.new(0.9, 0, 0, 35)
	boxFrame.BackgroundTransparency = 1
	boxFrame.Parent = main

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(0.6, 0, 1, 0)
	lbl.BackgroundTransparency = 1
	lbl.Text = lblText
	lbl.TextColor3 = Color3.new(1, 1, 1)
	lbl.Font = Enum.Font.GothamSemibold
	lbl.TextScaled = true
	lbl.TextWrapped = true
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Parent = boxFrame

	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MaxTextSize = 13
	constraint.Parent = lbl

	local input = Instance.new("TextBox")
	input.Size = UDim2.new(0.4, 0, 1, 0)
	input.Position = UDim2.new(0.6, 0, 0, 0)
	input.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	input.TextColor3 = Color3.new(1, 1, 1)
	input.Font = Enum.Font.Gotham
	input.TextSize = 14
	input.Text = tostring(defaultVal)
	input.Parent = boxFrame
	Instance.new("UICorner", input).CornerRadius = UDim.new(0, 4)

	input.FocusLost:Connect(function()
		local val = tonumber(input.Text)
		if val then
			onChange(val)
		else
			input.Text = tostring(defaultVal)
		end
	end)
end

