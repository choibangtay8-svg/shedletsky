-- esp
local function applyESP(mod, killer)
	if mod:FindFirstChild("ESP_Highlight") then return end

	local root = mod:WaitForChild("HumanoidRootPart", 5)
	local hum = mod:WaitForChild("Humanoid", 5)
	if not root or not hum then return end

	local hl = Instance.new("Highlight")
	hl.Name = "ESP_Highlight"
	hl.Adornee = mod
	hl.FillColor = killer and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(50, 255, 50)
	hl.FillTransparency = 0.5
	hl.OutlineColor = Color3.fromRGB(255, 255, 255)
	hl.OutlineTransparency = 0
	hl.Parent = mod

	local bb = Instance.new("BillboardGui")
	bb.Name = "ESP_Billboard"
	bb.Adornee = root
	bb.Size = UDim2.new(0, 200, 0, 50)
	bb.StudsOffset = Vector3.new(0, 3, 0)
	bb.AlwaysOnTop = true
	bb.Parent = mod

	local txt = Instance.new("TextLabel")
	txt.Size = UDim2.new(1, 0, 1, 0)
	txt.BackgroundTransparency = 1
	txt.TextColor3 = killer and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(80, 255, 80)
	txt.Font = Enum.Font.GothamBold
	txt.TextSize = 13
	txt.TextStrokeTransparency = 0
	txt.Parent = bb

	local renderConn
	renderConn = RunService.RenderStepped:Connect(function()
		if not mod.Parent or not root.Parent or not hum.Parent then
			renderConn:Disconnect()
			return
		end
		
		local myChar = lp.Character
		local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
		local dist = myHrp and math.floor((myHrp.Position - root.Position).Magnitude) or 0
		
		if killer then
			txt.Text = string.format("Killer | %dm", dist)
		else
			txt.Text = string.format("Survivor | HP: %d | %dm", math.max(0, math.floor(hum.Health)), dist)
		end
	end)
end

local function initFolder(folder, isKiller)
	for _, obj in ipairs(folder:GetChildren()) do
		if obj:IsA("Model") then
			task.spawn(function() applyESP(obj, isKiller) end)
		end
	end
	folder.ChildAdded:Connect(function(obj)
		if obj:IsA("Model") then
			task.spawn(function() applyESP(obj, isKiller) end)
		end
	end)
end

