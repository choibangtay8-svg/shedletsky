local function setupChar(char)
    local hum = char:WaitForChild("Humanoid")

    hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
        if hum.WalkSpeed < 16 then
            hum.WalkSpeed = 16
        elseif hum.WalkSpeed > 17 and hum.WalkSpeed < 30 then
            hum.WalkSpeed = 30
        end
    end)

    if hum.WalkSpeed > 17 and hum.WalkSpeed < 30 then
        hum.WalkSpeed = 30
    elseif hum.WalkSpeed < 16 then
        hum.WalkSpeed = 16
    end

    hum:GetPropertyChangedSignal("JumpPower"):Connect(function()
        if hum.JumpPower < 50 then
            hum.JumpPower = 50
        end
    end)

    hum:GetPropertyChangedSignal("PlatformStand"):Connect(function()
        if hum.PlatformStand then
            hum.PlatformStand = false
        end
    end)

    hum.StateChanged:Connect(function(_, state)
        if state == Enum.HumanoidStateType.Physics or state == Enum.HumanoidStateType.FallingDown or state == Enum.HumanoidStateType.Ragdoll then
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end
    end)
end

