-- smooth ping checker
task.spawn(function()
	while true do
		local ping = 20
		local success, result = pcall(function()
			return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
		end)
		
		if success and result and result > 0 then
			ping = result
		else
			local pcall2, pingVal = pcall(function() return lp:GetNetworkPing() * 1000 end)
			if pcall2 and pingVal and pingVal > 0 then
				ping = pingVal
			end
		end

		currentPing = currentPing + (ping - currentPing) * 0.25
		task.wait(0.2)
	end
end)

local function getPredictMult()
	local p = math.clamp(currentPing, 20, 150)
	return math.clamp(1.0 + ((p - 20) / 130) * 1.0, 1.0, 2.0)
end

